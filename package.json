{
  "name": "chronos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CHRONOS – eine wissenschaftlich fundierte, erweiterbare Enzyklopädie der Menschheitsgeschichte (Progressive Web App).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "content": "node scripts/build-content.ts",
    "content:check": "node scripts/build-content.ts --check",
    "media": "node scripts/fetch-media.ts",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc -b && vite build",
    "preview": "node scripts/serve-dist.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run content:check && tsc -b && vitest run",
    "test:e2e": "node scripts/e2e-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.55.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
